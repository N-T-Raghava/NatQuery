erDiagram
  notice {
    serial notice_id PK
    text title
    text body
    int posted_by_account_id FK
    varchar audience
    timestamptz posted_at
    timestamptz expires_at
  }
  account {
    serial account_id PK
  }
  physical_item_movement {
    serial item_movement_id PK
    int dispatch_id FK
    int to_account_id FK
    varchar status
    timestamptz moved_at
  }
  efile_movement {
    serial movement_id PK
    int efile_id FK
    int from_account_id FK
    int to_account_id FK
    timestamptz sent_at
    timestamptz received_at
    text remarks
  }
  efile_category {
    serial category_id PK
    int department_id FK
    text name
  }
  grievance {
    serial grievance_id PK
    int account_id FK
    varchar category
    text description
    varchar status
    int assigned_to_account_id FK
    timestamptz created_at
  }
  application_step {
    serial step_id PK
    int application_id FK
    smallint step_no
    int approver_account_id FK
    varchar action
    text remarks
    timestamptz acted_at
  }
  department {
    serial department_id PK
  }
