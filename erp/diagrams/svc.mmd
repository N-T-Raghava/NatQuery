    int department_id FK
    text subject
    int created_by_account_id FK
    varchar status
    timestamptz created_at
  }
  mail_message {
    serial message_id PK
    int from_account_id FK
    text subject
    text body
    timestamptz sent_at
  }
  counselling_session {
    serial session_id PK
    int student_id FK
    int counsellor_employee_id FK
    timestamptz scheduled_at
    varchar status
    text notes
  }
  application_type {
    serial type_id PK
    varchar code UK
    text name
    varchar category
  }
  complaint {
    serial complaint_id PK
    int account_id FK
    varchar category
    text subject
    text description
    varchar status
    timestamptz created_at
    timestamptz resolved_at
  }
  student {
    serial student_id PK
  }
  employee {
    serial employee_id PK
  }
  person {
    serial person_id PK
  }
  physical_dispatch {
    serial dispatch_id PK
    int department_id FK
    varchar direction
    varchar item_type
    text description
    text party
    varchar ref_no
    date dated
    int handled_by_account_id FK
  }
